# Neon: use the POOLED connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=
JWT_SECRET=            # openssl rand -base64 32
OWNER_EMAIL=
OWNER_PASSWORD_HASH=   # node -e "console.log(require('bcryptjs').hashSync('YourPassword',12))"
BREVO_API_KEY=         # set to "console" in local dev to print emails instead of sending
BREVO_SENDER_EMAIL=
ABLY_API_KEY=          # used from Phase 2
APP_URL=http://localhost:3000
CRON_SECRET=           # used from Phase 7
REALTIME_DRIVER=ably   # "console" logs events to a file instead of calling Ably (dev/tests only)
STATUS_POLL_MS=15000   # fallback polling interval for live status (safety net if realtime drops)
